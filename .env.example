# Na Vercel, ao ligar o banco Neon (Storage > Neon), a variável DATABASE_URL é criada sozinha.
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Opcional. Se não definir, o sistema gera uma chave e guarda no banco.
# SESSION_SECRET=uma-frase-longa-e-aleatoria

# Só para testar no computador sem Postgres:
# DATABASE_URL=pglite:./.data
